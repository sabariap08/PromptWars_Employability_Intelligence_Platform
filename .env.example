# ============================================================
# Employability Intelligence Platform (EIP) - environment
# Copy this file to .env and fill in real values.
# NEVER commit .env.
# ============================================================

APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
SESSION_COOKIE_SECURE=false

# MongoDB Atlas connection string. Leave empty to run the app in
# in-memory demo mode (data is lost on restart).
MONGODB_URI=
MONGODB_DB_NAME=eip

# Bootstrap credentials for the first Super Admin (used by
# scripts/create_super_admin.py and on first app start when demo seed is on).
# Set a unique, strong password before deploying.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_NAME=Platform Owner

# Demo seed data (approved university/company + demo accounts).
# Keep false for production. Only applied when the database is empty.
SEED_DEMO_ON_START=false

# Email verification codes are sent by email. When no SMTP provider is
# configured the code is written to the server console and, only in
# non-production, exposed to the client for development.
# Gmail example: server smtp.gmail.com, port 587, username = address,
# password = 16-character Google App Password (2-Step Verification required).
EMAIL_DELIVERY=console
EXPOSE_VERIFICATION_LINK=false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eip.local

# ------------------------------------------------------------
# AI providers (all optional). Keys are read server-side only.
# With no provider configured the platform uses deterministic
# rule-based analysis and templated explanations.
# ------------------------------------------------------------
AI_PRIMARY_PROVIDER=
AI_FALLBACK_ORDER=groq,gemini,openrouter,huggingface,ollama
AI_TIMEOUT_SECONDS=25

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

OLLAMA_ENABLED=false
# Local: http://localhost:11434 (no key). Ollama Cloud: https://ollama.com + OLLAMA_API_KEY.
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1

# Assessment limits and uploads
MAX_ASSESSMENT_ATTEMPTS=5
MAX_UPLOAD_MB=5
RATELIMIT_ENABLED=true
